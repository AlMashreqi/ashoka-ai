SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
ADMIN_SECRET=replace-with-a-long-random-secret
BASE_URL=https://www.ashoka.edu.in/department/department-of-cs/
HTML_PATH_PREFIXES=/department/department-of-cs/

AI_PROVIDER=ollama
ENABLE_HOSTED_DEV_PROVIDERS=false
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_EMBEDDING_ENDPOINT=http://127.0.0.1:11434/api/embed
# Hosted deployments must point both OLLAMA_*_ENDPOINT values at a network-reachable model service.
AI_TIMEOUT_MS=30000

# Set AI_PROVIDER=nvidia and ENABLE_HOSTED_DEV_PROVIDERS=true only for hosted development.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=replace-with-your-nvidia-api-key
# NVIDIA_CHAT_MODEL=replace-with-an-nvidia-chat-model
# NVIDIA_EMBEDDING_MODEL=replace-with-an-nvidia-embedding-model
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# OPENROUTER_CHAT_MODEL=replace-with-an-openrouter-chat-model
# OPENROUTER_EMBEDDING_MODEL=replace-with-an-openrouter-embedding-model

CRAWL_REQUESTS_PER_SECOND=1
CRAWL_MAX_PAGES=50
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_RESPONSE_BYTES=2000000
CRAWL_MAX_RETRIES=2
RETRIEVAL_LIMIT=5
# Minimum cosine similarity for semantic-only matches; lexical matches remain eligible.
RETRIEVAL_MIN_SCORE=0.60
MAX_ANSWER_WORDS=250
EMBEDDING_DIMENSIONS=768
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=86400
# Optional separate server secret; ADMIN_SECRET is used if omitted.
# RATE_LIMIT_SALT=replace-with-a-separate-long-random-secret
# Configure only behind a proxy whose header is trusted by the deployment.
# TRUSTED_IP_HEADER=cf-connecting-ip
